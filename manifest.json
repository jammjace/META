{
  "manifest_version": 3,
  "name": "Cognitive Mirror",
  "version": "0.1.1",
  "description": "A gentle pause to think for yourself while using ChatGPT.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "sidePanel"],
  "host_permissions": ["https://api.openai.com/*", "https://generativelanguage.googleapis.com/*"],
  "background": {"service_worker": "background/service-worker.js", "type": "module"},
  "action": {"default_title": "Open Cognitive Mirror"},
  "side_panel": {"default_path": "sidepanel/index.html"},
  "chrome_url_overrides": {"newtab": "newtab/flashcard.html"},
  "content_scripts": [{"matches": ["https://chatgpt.com/*"], "js": ["content/chat-observer.js"], "run_at": "document_idle"}]
}
